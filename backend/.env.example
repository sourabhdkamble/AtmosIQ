# ==============================================================================
# AtmosIQ Backend — Environment Variables Configuration
# ==============================================================================
# Copy this file to `backend/.env` and update the values.
# NEVER commit the real `.env` file to version control.

# Google Gemini API Key
# Required when ATMOSIQ_USE_GEMINI is set to true.
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Enable or disable Gemini LLM integration (true / false)
# Set to 'false' to run AtmosIQ entirely offline using local keyword routing and advice fallbacks.
ATMOSIQ_USE_GEMINI=false

# Gemini model identifier (optional, defaults to gemini-1.5-flash)
ATMOSIQ_GEMINI_MODEL=gemini-1.5-flash

# Supervisor local keyword routing bypass (optional: 1 to force local keyword routing, 0 to allow LLM)
ATMOSIQ_LOCAL_ROUTING=0

# Allowed CORS Origins (comma-separated list for local development and dashboard access)
ATMOSIQ_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000
